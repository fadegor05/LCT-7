# Шаблон переменных окружения для ml/. Скопируйте в ml/.env и заполните.
#
#     cp ml/.env.dist ml/.env
#
# Сам ml/.env в git не попадает (см. .gitignore) — и не должен: в нём токены.
# Здесь только имена и пояснения, без значений.

# --- веса детектора -----------------------------------------------------
# Репозиторий с весами на HuggingFace, вида «владелец/название». Модель
# приватная (D-005: снимки организаторов и всё производное не публикуем), и
# доступ выдаётся участием в организации команды, а не общим токеном.
HF_REPO=

# Личный токен HuggingFace с правом чтения. У каждого участника свой:
# общий токен нельзя отозвать у одного человека, не сломав доступ всем.
# Создаётся в настройках профиля: Access Tokens → New token → Read.
HF_TOKEN=

# --- сервис детекции ----------------------------------------------------
# Путь к файлу весов внутри контейнера или на машине. Если не задан, берётся
# значение по умолчанию из service/detector.py.
# WEIGHTS=/weights/mocs_m_best.pt

# Предел размера загружаемого кадра в байтах (по умолчанию 20 МБ).
# MAX_UPLOAD_BYTES=20971520

# --- исследование -------------------------------------------------------
# Нужен только для повторения эксперимента E20 (внешний набор Roboflow).
# Для работы сервиса и цепочки не требуется.
# ROBOFLOW_API_KEY=

# --- языковая модель -----------------------------------------------------
# Две поверхности, обе описаны в docs/ASSISTANT.md:
#   - ручка POST /ask и tools/ask_report.py — ответ на вопрос по готовому
#     отчёту, каждое число ответа сверяется с исходными данными;
#   - tools/suggest_stage_mapping.py — разбор названий работ из плана заказчика.
# В порождение выводов языковая модель не допущена: статусы и отклонения
# считают правила (D-020).
# Адрес должен принимать запросы формата chat completions — подойдёт и облачный
# сервис, и локальная модель. Без этих переменных инструмент не падает, а
# показывает запрос, который отправил бы.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
