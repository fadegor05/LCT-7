# Скопируйте в .env и при необходимости поправьте значения.

DOMAIN=localhost
SECURE=false

# Под каким префиксом Traefik отдаёт backend (PathPrefix(`/api`)).
API_PREFIX=/api

# PostgreSQL (вложенные секции через двойное подчёркивание, как в pydantic-settings)
POSTGRES__HOST=postgres
POSTGRES__PORT=5432
POSTGRES__USER=app_user
POSTGRES__DB=postgres
POSTGRES__PASSWORD=supersecretpassword

# Frontend в `make dev`: true — данные из MSW-моков (frontend/src/mocks), false — реальный backend.
VITE_USE_MOCKS=true

# ML-детектор: адрес сервиса обнаружения объектов
# Пусто или отсутствует -> NullDetector, фото остаются в статусе pending
# Примеры: http://ml:8000 (в compose), http://localhost:8000 (локальная разработка)
DETECTOR__URL=http://ml:8000

# Включить чтение даты со штампа через ML-сервис (LCT-13)
# true (по умолчанию) — штамп читается (оба нижних угла кадра), нужен DETECTOR__URL;
# false — штамп не читается, даты задаются вручную
# DETECTOR__STAMP_ENABLED=true

# Таймауты и параметры переподключения
# DETECTOR__TIMEOUT_S=30
# DETECTOR__CONNECT_TIMEOUT_S=2
# DETECTOR__MAX_CONCURRENCY=2
# DETECTOR__RETRY_BUDGET_S=20

# Токен HuggingFace для загрузки весов (make ml-weights)
# HF_TOKEN=

# Опорная дата расчёта отклонений (RecomputeCoordinator, LCT-14).
# today (по умолчанию) — date.today(). last_observation — своя дата для
# каждой площадки (последнее наблюдение на ней) — нужно для демо на
# площадках из разных лет. fixed — одна дата на всё окружение из
# ASSESSMENT__AS_OF_OVERRIDE ниже.
# Режим применяется только при СЛЕДУЮЩЕМ пересчёте площадки (новое фото,
# наблюдение или правка методики) — уже посчитанные статусы и отклонения
# на смену режима сами не пересчитываются.
# ASSESSMENT__AS_OF_MODE=last_observation
# Используется только при ASSESSMENT__AS_OF_MODE=fixed. Формат: YYYY-MM-DD
# ASSESSMENT__AS_OF_OVERRIDE=2024-03-15

# Ассистент по отчёту (ml-сервис)
# Обращение к внешней языковой модели, совместимой с /chat/completions (формат OpenAI).
# Может быть облачный сервис или локальная модель.
# Пусто или отсутствует -> ассистент отключен (POST /ask возвращает 503).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Ассистент: параметры ML-адаптера и API
# Максимально разрешённых запросов в минуту от одного пользователя (слайдящее окно)
# ASSISTANT__RATE_LIMIT_PER_MIN=10
# Таймаут ожидания ответа от ML-сервиса ассистента
# ASSISTANT__TIMEOUT_S=130
# Максимальный размер отчёта в KB перед отправкой в ассистент
# ASSISTANT__MAX_REPORT_KB=512

# Уведомления: телеграм-бот для доставки.
# Пусто или отсутствует -> сообщения только пишутся в лог приложения,
# кнопка привязки в личном кабинете отвечает «канал не настроен».
# Токен берётся у @BotFather, имя бота — без символа @.
# NOTIFY__TELEGRAM__TOKEN=
# NOTIFY__TELEGRAM__BOT_USERNAME=

# База для абсолютных ссылок в сообщениях (без завершающего слеша)
NOTIFY__PUBLIC_URL=http://localhost
