# Скопируйте в .env и при необходимости поправьте значения.

DOMAIN=localhost
SECURE=false

# Под каким префиксом Traefik отдаёт backend (PathPrefix(`/api`)).
API_PREFIX=/api

# PostgreSQL (вложенные секции через двойное подчёркивание, как в pydantic-settings)
POSTGRES__HOST=postgres
POSTGRES__PORT=5432
POSTGRES__USER=app_user
POSTGRES__DB=postgres
POSTGRES__PASSWORD=supersecretpassword

# Frontend в `make dev`: true — данные из MSW-моков (frontend/src/mocks), false — реальный backend.
VITE_USE_MOCKS=true
